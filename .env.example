# Copy this file to .env (or .env.local) and fill in your Supabase project's
# values from Project Settings -> API in the Supabase dashboard.
#
# These are also the two environment variables to set in Vercel
# (Project Settings -> Environment Variables) when you deploy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
